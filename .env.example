# 监听地址
JEVPROXY_LISTEN=:8080

# 数据目录（SQLite、admin.token、master.key）
JEVPROXY_DATA_DIR=./data

# 管理台令牌。留空则首次启动自动生成并写入 data/admin.token
JEVPROXY_ADMIN_TOKEN=

# AES-256 主密钥，64 位 hex（32 字节）。留空则首次启动自动生成并写入 data/master.key
# 旋转此密钥会使已加密的上游 Key 与用户 Key 哈希全部失效
JEVPROXY_MASTER_KEY=

# TypeSafe 上游
JEVPROXY_UPSTREAM=https://api.typesafe.ai
JEVPROXY_TIMEOUT=15s

# 日志：json / text
JEVPROXY_LOG_FORMAT=text
JEVPROXY_DEBUG=0
